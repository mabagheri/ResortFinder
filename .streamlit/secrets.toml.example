# Copy to .streamlit/secrets.toml (local) or paste into
# Streamlit Community Cloud > your app > Settings > Secrets.
# Only SERPAPI_KEY is required for live mode; every other site is optional.

# Required: finds the hotels, their class (2-5 stars) and the Google rating.
# https://serpapi.com  (free plan: 250 searches/month; one search page ~ 20 hotels)
SERPAPI_KEY = ""

# Optional: TripAdvisor rating (official Content API, 5,000 free calls/month).
# https://www.tripadvisor.com/developers
TRIPADVISOR_API_KEY = ""
# If your key is restricted to a domain, put that domain's URL here, e.g. "https://yourapp.streamlit.app"
TRIPADVISOR_REFERER = ""

# Optional: Booking.com (and Expedia) ratings through Apify scrapers ($5 free usage/month).
# https://console.apify.com/settings/integrations
APIFY_TOKEN = ""
# Booking.com scraper (default shown). Input placeholders: {area}, {max_items}
# BOOKING_APIFY_ACTOR = "voyager/booking-scraper"
# BOOKING_APIFY_INPUT = '{"search": "{area}", "maxItems": "{max_items}", "currency": "USD", "language": "en-gb"}'

# Expedia: choose an Expedia / Hotels.com hotel scraper on https://apify.com/store,
# then set its id and input. Expedia shows scores out of 10.
EXPEDIA_APIFY_ACTOR = ""
# EXPEDIA_APIFY_INPUT = '{"location": "{area}", "maxItems": "{max_items}"}'
# EXPEDIA_RATING_SCALE = "10"

# Optional: Google Maps rating from the Google Places API, instead of Google Hotels' rating.
GOOGLE_PLACES_API_KEY = ""

# Optional but recommended on Streamlit Community Cloud: keep the saved area files permanently
# in GitHub (the app's own files are deleted when it restarts). Free.
# Create a fine-grained token at https://github.com/settings/personal-access-tokens
# with access to ONE repository and the permission "Contents: Read and write".
GITHUB_TOKEN = ""
GITHUB_REPO = ""             # e.g. "your-name/ResortFinder"
# GITHUB_BRANCH = "resort-data"   # created automatically; keep it different from the app's branch
